<UserControl
    x:Class="TCLauncher.Controls.Gallery.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls;assembly=TCLauncher">
    <StackPanel MaxWidth="760">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="SkeletonLoader" />
        <Grid Height="74" Margin="0,12,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:SkeletonLoader Background="#43546A" BorderRadius="8" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <controls:SkeletonLoader Height="18" Background="#43546A" BorderRadius="5" />
                <controls:SkeletonLoader Height="14" Margin="0,12,80,0" Background="#354A61" BorderRadius="5" />
            </StackPanel>
        </Grid>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Icon" />
        <WrapPanel Margin="0,12,0,26">
            <controls:Icon
                Margin="0,0,24,0"
                Color="#FFCF66"
                FontSize="28"
                FontFamily="Segoe UI Symbol"
                Unicode="2605" />
            <controls:Icon
                Margin="0,0,24,0"
                Color="#70D6A0"
                FontSize="28"
                FontFamily="Segoe UI Symbol"
                Unicode="2714" />
            <controls:Icon Color="#80BFFF" FontFamily="Segoe UI Symbol" FontSize="28" Unicode="2699" />
        </WrapPanel>
        <controls:HorizontalSeparator Fill="#43546A" Thickness="1" />
    </StackPanel>
</UserControl>
