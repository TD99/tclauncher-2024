<UserControl
    x:Class="TCLauncher.Controls.Gallery.PageTransitionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <StackPanel>
        <Border
            Margin="0,0,0,18"
            Padding="16"
            Background="#1D2633"
            BorderBrush="#344255"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Transition slowness" />
                <Slider
                    x:Name="SpeedSlider"
                    Grid.Column="1"
                    Width="240"
                    Margin="18,0"
                    Minimum="1"
                    Maximum="10"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    ValueChanged="SpeedSlider_OnValueChanged" />
                <TextBlock
                    x:Name="SpeedLabel"
                    Grid.Column="2"
                    MinWidth="44"
                    TextAlignment="Right"
                    Text="1.0x" />
            </Grid>
        </Border>

        <Grid
            x:Name="DemoFrame"
            Height="300"
            ClipToBounds="True">
            <ContentControl
                x:Name="PreviousDemoHost"
                Focusable="False"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Collapsed" />
            <ContentControl
                x:Name="CurrentDemoHost"
                Focusable="False"
                RenderTransformOrigin="0.5,0.5" />
        </Grid>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
            <Button
                Padding="16,9"
                Click="Previous_OnClick"
                Content="Previous" />
            <Button
                Margin="10,0,0,0"
                Padding="16,9"
                Click="Next_OnClick"
                Content="Next" />
        </StackPanel>
    </StackPanel>
</UserControl>
