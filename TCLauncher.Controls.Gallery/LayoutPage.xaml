<UserControl
    x:Class="TCLauncher.Controls.Gallery.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls;assembly=TCLauncher">
    <StackPanel MaxWidth="820">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="AdaptiveCardPanel" />
        <controls:AdaptiveCardPanel Margin="0,12,0,28" Gap="12" MinimumCardWidth="190" MaximumColumns="3">
            <Border Padding="18" Background="#222D3B" CornerRadius="8">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="Card one" /><TextBlock Margin="0,8,0,0" Foreground="#AEB8C7" Text="Fluid width" /></StackPanel>
            </Border>
            <Border Padding="18" Background="#222D3B" CornerRadius="8">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="Card two" /><TextBlock Margin="0,8,0,0" Foreground="#AEB8C7" Text="Shared rhythm" /></StackPanel>
            </Border>
            <Border Padding="18" Background="#222D3B" CornerRadius="8">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="Card three" /><TextBlock Margin="0,8,0,0" Foreground="#AEB8C7" Text="Responsive grid" /></StackPanel>
            </Border>
        </controls:AdaptiveCardPanel>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Spoiler" />
        <controls:Spoiler
            Margin="0,12,0,0"
            Padding="0"
            SpoilerContent="This content is revealed on click."
            SpoilerText="Show details"
            HorizontalAlignment="Left" />
        <TextBlock Margin="0,28,0,0" FontSize="18" FontWeight="SemiBold" Text="Expander motion" />
        <TextBlock Margin="0,8,0,12" Foreground="#AEB8C7" Text="Uses the same overshoot-and-settle motion as notifications in both directions." TextWrapping="Wrap" />
        <Border Padding="12" Background="#202A38" BorderBrush="#43546A" BorderThickness="1" CornerRadius="8">
            <Expander Header="Advanced controls">
                <StackPanel Margin="24,8,8,8">
                    <TextBlock FontWeight="SemiBold" Text="Animated disclosure content" />
                    <TextBlock Margin="0,6,0,0" Foreground="#AEB8C7" Text="It grows into place and eases away without an abrupt visibility change." TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </Border>
        <TextBlock Margin="0,28,0,0" FontSize="18" FontWeight="SemiBold" Text="ScrollShadowLayout" />
        <TextBlock Margin="0,8,0,12" Foreground="#AEB8C7" Text="Edge shadows appear only while more content is available in that direction." TextWrapping="Wrap" />
        <Border Height="190" Background="#202A38" BorderBrush="#43546A" BorderThickness="1" CornerRadius="8">
            <controls:ScrollShadowLayout
                Orientation="All"
                ShadowColor="#D9151D28"
                ShadowSize="14">
                <controls:ScrollShadowLayout.ScrollContent>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="980">
                            <TextBlock Margin="18,16,18,8" FontWeight="SemiBold" Text="Scroll in every direction" />
                            <TextBlock Margin="18,0,18,14" Foreground="#AEB8C7" Text="The shadow indicates when content continues beyond an edge." />
                            <WrapPanel Margin="18,0" Orientation="Horizontal">
                                <Border Width="210" Height="82" Margin="0,0,12,12" Padding="14" Background="#2A3A4D" CornerRadius="6"><TextBlock Text="Content card 1" /></Border>
                                <Border Width="210" Height="82" Margin="0,0,12,12" Padding="14" Background="#2A3A4D" CornerRadius="6"><TextBlock Text="Content card 2" /></Border>
                                <Border Width="210" Height="82" Margin="0,0,12,12" Padding="14" Background="#2A3A4D" CornerRadius="6"><TextBlock Text="Content card 3" /></Border>
                                <Border Width="210" Height="82" Margin="0,0,12,12" Padding="14" Background="#2A3A4D" CornerRadius="6"><TextBlock Text="Content card 4" /></Border>
                            </WrapPanel>
                            <TextBlock Margin="18,4,18,20" Foreground="#AEB8C7" Text="More content below and to the right." />
                        </StackPanel>
                    </ScrollViewer>
                </controls:ScrollShadowLayout.ScrollContent>
            </controls:ScrollShadowLayout>
        </Border>
    </StackPanel>
</UserControl>
