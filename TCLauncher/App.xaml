<Application
    x:Class="TCLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:TCLauncher.MVVM.View"
    xmlns:viewModel="clr-namespace:TCLauncher.MVVM.ViewModel"
    ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/MenuButtonTheme.xaml" />
                <ResourceDictionary Source="Theme/TextBoxTheme.xaml" />
                <ResourceDictionary Source="Theme/WindowControlButtonTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernButtonTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernToolTipTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernScrollbarTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernComboBoxTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernCheckBoxTheme.xaml" />
                <ResourceDictionary Source="Theme/ModernExpanderTheme.xaml" />
                <ResourceDictionary Source="Theme/ButtonComboBoxTheme.xaml" />
                <ResourceDictionary Source="Theme/SelectableLabel.xaml" />
                <ResourceDictionary Source="Theme/GlobalTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BusyIndicator;component/Theme/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
                <view:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:ServerListViewModel}">
                <view:ServerListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:SettingsViewModel}">
                <view:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:AccountListViewModel}">
                <view:AccountListView />
            </DataTemplate>

            <!--
                WPF creates editing menus for input controls independently of the
                ContextMenu style. Assign this menu explicitly so those menus use
                the same visual treatment as the rest of the application.
            -->
            <ContextMenu x:Key="TextEditingContextMenu" x:Shared="False" Style="{DynamicResource ModernContextMenu}">
                <MenuItem
                    Command="ApplicationCommands.Cut"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="Cut" />
                <MenuItem
                    Command="ApplicationCommands.Copy"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="Copy" />
                <MenuItem
                    Command="ApplicationCommands.Paste"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="Paste" />
                <Separator />
                <MenuItem
                    Command="ApplicationCommands.SelectAll"
                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                    Header="Select All" />
            </ContextMenu>

            <!--  Application controls use one consistent visual language by default.  -->
            <Style BasedOn="{StaticResource ModernButton}" TargetType="{x:Type Button}" />
            <Style BasedOn="{StaticResource ModernComboBox}" TargetType="{x:Type ComboBox}" />
            <Style BasedOn="{StaticResource ModernTextBox}" TargetType="{x:Type TextBox}">
                <Setter Property="ContextMenu" Value="{DynamicResource TextEditingContextMenu}" />
            </Style>
            <Style TargetType="{x:Type RichTextBox}">
                <Setter Property="ContextMenu" Value="{DynamicResource TextEditingContextMenu}" />
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="ContextMenu" Value="{DynamicResource TextEditingContextMenu}" />
            </Style>
            <Style BasedOn="{StaticResource ModernCheckbox}" TargetType="{x:Type CheckBox}" />

            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{DynamicResource Inter}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource Inter}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{DynamicResource Inter}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <FontFamily x:Key="FaRegular">Assets/Fonts/#Font Awesome 6 Free Regular</FontFamily>
            <FontFamily x:Key="FaSolid">Assets/Fonts/#Font Awesome 6 Free Solid</FontFamily>
            <FontFamily x:Key="FaBrands">Assets/Fonts/#Font Awesome 6 Brands Regular</FontFamily>
            <FontFamily x:Key="PixelifySans">Assets/Fonts/#Pixelify Sans Regular</FontFamily>
            <FontFamily x:Key="FiraCode">Assets/Fonts/#Fira Code</FontFamily>
            <FontFamily x:Key="Inter">Assets/Fonts/#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
