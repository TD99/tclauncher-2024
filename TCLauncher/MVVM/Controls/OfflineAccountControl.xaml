<UserControl
    x:Class="TCLauncher.MVVM.Controls.OfflineAccountControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core">
    <Border
        Padding="14"
        Background="#111821"
        CornerRadius="7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    Foreground="White"
                    Text="{Binding Username}" />
                <TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#eab464"
                    Text="{core:Localize Key=offline_badge}" />
            </StackPanel>
            <Button
                x:Name="LoginBtn"
                Grid.Column="1"
                Margin="8,0"
                Padding="12,6"
                Content="Login"
                Style="{StaticResource ModernButton}" />
            <Button
                x:Name="RemoveBtn"
                Grid.Column="2"
                Padding="12,6"
                Background="#55ff0000"
                Content="×"
                Style="{StaticResource ModernButton}" />
        </Grid>
    </Border>
</UserControl>