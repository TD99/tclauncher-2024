<UserControl x:Class="TCLauncher.MVVM.Controls.OfflineAccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TCLauncher.Core">
    <Border Padding="14" Background="#111821" CornerRadius="7">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding Username}" Foreground="White" FontSize="18"/><TextBlock Text="{core:Localize Key=offline_badge}" Foreground="#eab464" FontSize="11" FontWeight="Bold"/></StackPanel>
            <Button x:Name="LoginBtn" Grid.Column="1" Margin="8,0" Content="Login" Style="{StaticResource ModernButton}" Padding="12,6"/>
            <Button x:Name="RemoveBtn" Grid.Column="2" Content="×" Background="#55ff0000" Style="{StaticResource ModernButton}" Padding="12,6"/>
        </Grid>
    </Border>
</UserControl>
