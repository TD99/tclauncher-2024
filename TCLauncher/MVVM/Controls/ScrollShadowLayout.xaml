<UserControl
    x:Class="TCLauncher.MVVM.Controls.ScrollShadowLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ClipToBounds="True">
    <Grid>
        <ContentPresenter Content="{Binding ScrollContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Border x:Name="TopShadow" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        <Border x:Name="BottomShadow" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <Border x:Name="LeftShadow" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
        <Border x:Name="RightShadow" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
