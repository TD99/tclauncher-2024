<Window x:Class="TCLauncher.MVVM.Windows.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TCLauncher.Core"
        Title="{core:Localize Key=backup}" Width="640" Height="480" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#1d2633" Foreground="White" Icon="/Assets/Images/logo.png">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{core:Localize Key=backup}" FontFamily="{StaticResource PixelifySans}" FontSize="30"/><TextBlock x:Name="ProfileName" Margin="0,4,0,16" Foreground="#8ea6c8"/></StackPanel>
        <ListBox x:Name="BackupList" Grid.Row="1" DisplayMemberPath="DisplayLabel" Background="#111821" Foreground="White" BorderThickness="0" Padding="8"/>
        <CheckBox x:Name="FullBackup" Grid.Row="2" Margin="0,14" Content="{core:Localize Key=full_backup}" Style="{StaticResource ModernCheckbox}"/>
        <DockPanel Grid.Row="3">
            <Button Content="{core:Localize Key=create_backup}" Click="Create_Click" Style="{StaticResource ModernButton}" Padding="14,8"/>
            <Button DockPanel.Dock="Right" Content="{core:Localize Key=restore_backup}" Click="Restore_Click" Style="{StaticResource ModernButton}" Padding="14,8"/>
        </DockPanel>
    </Grid>
</Window>
