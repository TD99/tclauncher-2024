<Window x:Class="TCLauncher.MVVM.Windows.ProfileCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TCLauncher.Core"
        xmlns:converters="clr-namespace:TCLauncher.MVVM.Converters"
        Title="{core:Localize Key=profile_creator}" Width="620" Height="560"
        MinWidth="560" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="#1d2633" Foreground="White" Icon="/Assets/Images/logo.png">
    <Window.Resources>
        <converters:WizardStepVisibilityConverter x:Key="StepVisibility" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#b2b9cc" /></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="{core:Localize Key=profile_creator}" FontFamily="{StaticResource PixelifySans}" FontSize="30" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StepLabel}" Foreground="#8ea6c8" FontSize="16" VerticalAlignment="Center" />
        </DockPanel>
        <ProgressBar Grid.Row="1" Margin="0,14,0,20" Height="4" Minimum="0" Maximum="5" Value="{Binding CurrentStep}" />
        <TabControl Grid.Row="2" SelectedIndex="{Binding CurrentStep}" Background="Transparent" BorderThickness="0">
            <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>
            <TabItem><StackPanel>
                <Label Content="{core:Localize Key=profile_name}"/><TextBox Text="{Binding Draft.DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                <Label Margin="0,12,0,0" Content="{core:Localize Key=internal_name}"/><TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                <Label Margin="0,12,0,0" Content="Icon"/><DockPanel><Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="…" Click="BrowseIcon_Click" Style="{StaticResource ModernButton}"/><TextBox Text="{Binding Draft.IconPath}" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/></DockPanel>
                <Label Margin="0,12,0,0" Content="Storage"/><TextBlock Text="{Binding StorageRoot}" TextWrapping="Wrap" Foreground="#8ea6c8"/>
            </StackPanel></TabItem>
            <TabItem><StackPanel><Label Content="{core:Localize Key=minecraft_version_label_text}"/><TextBox Text="{Binding Draft.MinecraftVersion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/><TextBlock Margin="0,12,0,0" Text="Examples: 1.20.1, 1.21.1" Foreground="#8ea6c8"/></StackPanel></TabItem>
            <TabItem><StackPanel><Label Content="{core:Localize Key=loader}"/><ComboBox ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding Draft.LoaderType}" Style="{StaticResource ModernComboBox}"/><Label Margin="0,12,0,0" Content="{core:Localize Key=loader_version}"/><TextBox Text="{Binding Draft.LoaderVersion}" Style="{StaticResource ModernTextBox}"/></StackPanel></TabItem>
            <TabItem><StackPanel><Label Content="{core:Localize Key=memory}"/><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><Label Content="Minimum RAM (MB)"/><TextBox Text="{Binding Draft.MinimumRamMb}" Style="{StaticResource ModernTextBox}"/></StackPanel><StackPanel Margin="8,0,0,0"><Label Content="Maximum RAM (MB)"/><TextBox Text="{Binding Draft.MaximumRamMb}" Style="{StaticResource ModernTextBox}"/></StackPanel></UniformGrid><Label Margin="0,12,0,0" Content="JVM arguments"/><TextBox Text="{Binding Draft.JvmArguments}" Style="{StaticResource ModernTextBox}"/><CheckBox Margin="0,18,0,0" Content="{core:Localize Key=isolation}" IsChecked="{Binding Draft.Isolated}" Style="{StaticResource ModernCheckbox}"/></StackPanel></TabItem>
            <TabItem><StackPanel><Label Content="{core:Localize Key=server_address}"/><TextBox Text="{Binding Draft.ServerAddress}" Style="{StaticResource ModernTextBox}"/><TextBlock Margin="0,12,0,0" Text="Leave empty to choose a server when playing." Foreground="#8ea6c8"/></StackPanel></TabItem>
            <TabItem><StackPanel><TextBlock Text="{core:Localize Key=review}" FontSize="24" Margin="0,0,0,18"/><TextBlock Text="{Binding Draft.DisplayName, StringFormat=Profile: {0}}"/><TextBlock Margin="0,8,0,0" Text="{Binding Draft.MinecraftVersion, StringFormat=Minecraft: {0}}"/><TextBlock Margin="0,8,0,0" Text="{Binding Draft.LoaderType, StringFormat=Loader: {0}}"/><TextBlock Margin="0,8,0,0" Text="{Binding Draft.MaximumRamMb, StringFormat=Maximum RAM: {0} MB}"/><TextBlock Margin="0,8,0,0" Text="{Binding Draft.ServerAddress, StringFormat=Server: {0}}"/></StackPanel></TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Margin="0,12" Text="{Binding ErrorMessage}" Foreground="#ff8c8c" TextWrapping="Wrap" />
        <DockPanel Grid.Row="4">
            <Button Content="{core:Localize Key=installer_back}" Command="{Binding BackCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=NotFirst}" Style="{StaticResource ModernButton}" Padding="16,8"/>
            <Button DockPanel.Dock="Right" Content="{core:Localize Key=installer_next}" Command="{Binding NextCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=NotLast}" Style="{StaticResource ModernButton}" Padding="18,8"/>
            <Button DockPanel.Dock="Right" Content="{core:Localize Key=create_profile}" Command="{Binding CreateCommand}" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=Last}" Style="{StaticResource ModernButton}" Padding="18,8"/>
        </DockPanel>
    </Grid>
</Window>
