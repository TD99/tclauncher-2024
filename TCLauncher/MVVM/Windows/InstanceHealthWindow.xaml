<Window x:Class="TCLauncher.MVVM.Windows.InstanceHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TCLauncher.Core"
        Title="{core:Localize Key=health}" Width="680" Height="560" MinWidth="560" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="#1d2633" Foreground="White" Icon="/Assets/Images/logo.png">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{core:Localize Key=health}" FontFamily="{StaticResource PixelifySans}" FontSize="30"/><TextBlock x:Name="ProfileName" Margin="0,4,0,16" Foreground="#8ea6c8"/></StackPanel>
        <ScrollViewer Grid.Row="1"><ItemsControl x:Name="Checks"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="12" Background="#111821" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#b2b9cc"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="{core:Localize Key=backup}" Click="Backup_Click" Style="{StaticResource ModernButton}" Padding="14,8"/>
            <Button Content="{core:Localize Key=support_bundle}" Click="Support_Click" Style="{StaticResource ModernButton}" Padding="14,8"/>
        </StackPanel>
    </Grid>
</Window>
