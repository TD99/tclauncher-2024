<UserControl
    x:Class="TCLauncher.MVVM.View.ProfileCreatorSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TCLauncher.MVVM.Converters"
    xmlns:core="clr-namespace:TCLauncher.Core">
    <UserControl.Resources>
        <converters:WizardStepVisibilityConverter x:Key="StepVisibility" />
    </UserControl.Resources>
    <Grid MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#8EA6C8"
                Text="{Binding StepLabel}" />
            <ProgressBar
                Height="4"
                Margin="14,0,0,0"
                Maximum="5"
                Minimum="0"
                Value="{Binding CurrentStep}" />
        </DockPanel>
        <TabControl
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            SelectedIndex="{Binding CurrentStep}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.Resources>
            <TabItem>
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" Text="{core:Localize Key=profile_name}" />
                    <TextBox Text="{Binding Draft.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,14,0,6" Text="{core:Localize Key=internal_name}" />
                    <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,14,0,6" Text="Icon" />
                    <DockPanel>
                        <Button
                            Margin="8,0,0,0"
                            Click="BrowseIcon_Click"
                            Content="Browse…"
                            DockPanel.Dock="Right" />
                        <TextBox IsReadOnly="True" Text="{Binding Draft.IconPath}" />
                    </DockPanel>
                    <TextBlock Margin="0,14,0,4" Text="Storage" />
                    <TextBlock
                        Foreground="#8EA6C8"
                        Text="{Binding StorageRoot}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
            <TabItem>
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" Text="{core:Localize Key=minecraft_version_label_text}" />
                    <TextBox Text="{Binding Draft.MinecraftVersion, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#8EA6C8"
                        Text="For example: 1.20.1 or 1.21.1" />
                </StackPanel>
            </TabItem>
            <TabItem>
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" Text="{core:Localize Key=loader}" />
                    <ComboBox ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding Draft.LoaderType}" />
                    <TextBlock Margin="0,14,0,6" Text="{core:Localize Key=loader_version}" />
                    <TextBox Text="{Binding Draft.LoaderVersion}" />
                </StackPanel>
            </TabItem>
            <TabItem>
                <StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,7,0">
                            <TextBlock Margin="0,0,0,6" Text="Minimum RAM (MB)" />
                            <TextBox Text="{Binding Draft.MinimumRamMb}" />
                        </StackPanel>
                        <StackPanel Margin="7,0,0,0">
                            <TextBlock Margin="0,0,0,6" Text="Maximum RAM (MB)" />
                            <TextBox Text="{Binding Draft.MaximumRamMb}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,14,0,6" Text="JVM arguments" />
                    <TextBox
                        MinHeight="86"
                        Style="{StaticResource ModernMultilineTextBox}"
                        Text="{Binding Draft.JvmArguments}" />
                    <CheckBox
                        Margin="0,14,0,0"
                        Content="{core:Localize Key=isolation}"
                        IsChecked="{Binding Draft.Isolated}" />
                </StackPanel>
            </TabItem>
            <TabItem>
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" Text="Optional default server" />
                    <TextBox Text="{Binding Draft.ServerAddress}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#8EA6C8"
                        Text="Leave empty to choose while playing." />
                </StackPanel>
            </TabItem>
            <TabItem>
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Ready to create" />
                    <TextBlock Margin="0,16,0,0" Text="{Binding Draft.DisplayName, StringFormat=Profile: {0}}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding Draft.MinecraftVersion, StringFormat=Minecraft: {0}}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding Draft.LoaderType, StringFormat=Loader: {0}}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding Draft.MaximumRamMb, StringFormat=Maximum RAM: {0} MB}" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock
            Grid.Row="2"
            Margin="0,14,0,0"
            Foreground="#FF9A9A"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button
                Padding="15,8"
                Command="{Binding BackCommand}"
                Content="{core:Localize Key=installer_back}"
                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=NotFirst}" />
            <Button
                Padding="17,8"
                Command="{Binding NextCommand}"
                Content="{core:Localize Key=installer_next}"
                DockPanel.Dock="Right"
                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=NotLast}" />
            <Button
                Padding="17,8"
                Command="{Binding CreateCommand}"
                Content="{core:Localize Key=create_profile}"
                DockPanel.Dock="Right"
                Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=Last}" />
        </DockPanel>
    </Grid>
</UserControl>