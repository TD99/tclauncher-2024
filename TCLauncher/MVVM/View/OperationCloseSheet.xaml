<UserControl x:Class="TCLauncher.MVVM.View.OperationCloseSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:TCLauncher.Core">
    <StackPanel><TextBlock Text="{core:Localize Key=operation_close_help}" TextWrapping="Wrap" Foreground="#C7D0DC"/><StackPanel Margin="0,18,0,0"><Button Padding="14,8" Content="{core:Localize Key=operation_wait_exit}" Click="Wait_Click"/><Button Margin="0,8,0,0" Padding="14,8" Content="{core:Localize Key=operation_cancel_exit}" Click="Cancel_Click"/><Button Margin="0,8,0,0" Padding="14,8" Content="Force exit now" Background="#63343A" BorderBrush="#9A555F" Click="ForceExit_Click"/><Button Margin="0,8,0,0" Padding="14,8" Content="{core:Localize Key=operation_stay}" Click="Stay_Click"/></StackPanel></StackPanel>
</UserControl>
