<UserControl
    x:Class="TCLauncher.MVVM.View.OperationCloseSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core">
    <StackPanel>
        <TextBlock
            Foreground="#C7D0DC"
            Text="{core:Localize Key=operation_close_help}"
            TextWrapping="Wrap" />
        <StackPanel Margin="0,18,0,0">
            <Button
                Padding="14,8"
                Click="Wait_Click"
                Content="{core:Localize Key=operation_wait_exit}" />
            <Button
                Margin="0,8,0,0"
                Padding="14,8"
                Click="Cancel_Click"
                Content="{core:Localize Key=operation_cancel_exit}" />
            <Button
                Margin="0,8,0,0"
                Padding="14,8"
                Background="#63343A"
                BorderBrush="#9A555F"
                Click="ForceExit_Click"
                Content="Force exit now" />
            <Button
                Margin="0,8,0,0"
                Padding="14,8"
                Click="Stay_Click"
                Content="{core:Localize Key=operation_stay}" />
        </StackPanel>
    </StackPanel>
</UserControl>