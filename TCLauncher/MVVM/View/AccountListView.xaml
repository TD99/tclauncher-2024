<UserControl x:Class="TCLauncher.MVVM.View.AccountListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TCLauncher.MVVM.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#1D2633" d:DesignHeight="500" d:DesignWidth="800" Loaded="AccountView_OnLoaded"
    mc:Ignorable="d" Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock FontFamily="{StaticResource PixelifySans}" FontSize="29" Text="Accounts" />
            <TextBlock Margin="0,3,0,0" Foreground="#AEB8C7" Text="Choose a Microsoft account or an explicit offline identity." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
            <ItemsControl x:Name="Accounts" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="14" MinHeight="88" Background="#222D3B" BorderBrush="#344255"
                                BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" Background="#16202C" CornerRadius="9" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding AvatarUri}" Stretch="UniformToFill" Visibility="{Binding IsMicrosoft, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Text="⌁"
                                                   Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="Offline account" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Username}" />
                                        <Border Margin="9,0,0,0" Padding="7,2" Background="#183D35" CornerRadius="5"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10" Foreground="#83D5BB" Text="Selected" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" Foreground="#AEB8C7" Text="{Binding Subtitle}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="82" Margin="10,0" Padding="12,7" Tag="{Binding}" Click="SelectAccount_OnClick">
                                    <TextBlock Text="Select" />
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="3" Width="38" Padding="0" Tag="{Binding}" Content="×" ToolTip="Remove account"
                                        Click="RemoveAccount_OnClick" Background="#493039" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Padding="14,8" Click="NewAccountBtn_OnClick" Content="Add Microsoft account" />
                <Button Margin="9,0,0,0" Padding="14,8" Click="NewOfflineBtn_OnClick" Content="Add offline profile" />
            </StackPanel>
            <Button x:Name="LogoutBtn" HorizontalAlignment="Right" Padding="14,8" Click="LogoutBtn_OnClick" Content="Clear selection" />
        </Grid>
    </Grid>
</UserControl>
