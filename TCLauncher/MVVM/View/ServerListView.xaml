<UserControl x:Class="TCLauncher.MVVM.View.ServerListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls"
    xmlns:converters="clr-namespace:TCLauncher.MVVM.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#1D2633" d:DesignHeight="600" d:DesignWidth="960" mc:Ignorable="d"
    Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource PixelifySans}" FontSize="29" Text="Games" />
                <TextBlock Margin="0,3,0,0" Foreground="#AEB8C7" FontSize="13"
                           Text="Browse T-Craft games and manage profiles already on this PC." />
            </StackPanel>
            <Button x:Name="GamesMenuButton" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="☰" ToolTip="Games menu" Click="GamesMenuButton_OnClick">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Create profile" Click="CreateProfile_OnClick" />
                        <MenuItem Header="Import package" Click="ImportPackage_OnClick" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="230" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MinHeight="40" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by name, tag, version, or loader" AutomationProperties.Name="Search games" />
            <ComboBox Grid.Column="1" Width="120" Margin="10,0,0,0" ItemsSource="{Binding LoaderFilters}"
                      SelectedItem="{Binding LoaderFilter}" AutomationProperties.Name="Loader filter" />
            <ComboBox Grid.Column="2" Width="135" Margin="10,0,0,0" ItemsSource="{Binding MinecraftVersionFilters}"
                      SelectedItem="{Binding MinecraftVersionFilter}" AutomationProperties.Name="Minecraft version filter" />
            <ComboBox Grid.Column="3" Width="120" Margin="10,0,0,0" ItemsSource="{Binding AvailabilityFilters}"
                      SelectedItem="{Binding AvailabilityFilter}" AutomationProperties.Name="Availability filter" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding ServerList}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 KeyboardNavigation.TabNavigation="Continue" IsTabStop="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:AdaptiveCardPanel MinimumCardWidth="230" Gap="16" MinimumColumns="2" MaximumColumns="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding}" Click="GameCard_OnClick" Padding="0" Background="Transparent"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding DisplayName}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card" MinHeight="232" Background="#273241" BorderBrush="#344255"
                                        BorderThickness="1" CornerRadius="12" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="#121923" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailURL}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,9,0,0">
                                                <Border Margin="0,0,6,0" Padding="7,3" Background="#17202C" CornerRadius="6">
                                                    <TextBlock FontSize="11" Foreground="#CED6E2" Text="{Binding McVersion}" />
                                                </Border>
                                                <Border Margin="0,0,6,0" Padding="7,3" Background="#17202C" CornerRadius="6">
                                                    <TextBlock FontSize="11" Foreground="#CED6E2" Text="{Binding Loader.Type}" />
                                                </Border>
                                                <Border Padding="7,3" Background="#183D35" CornerRadius="6">
                                                    <TextBlock FontSize="11" Foreground="#83D5BB">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"><Setter Property="Text" Value="Available" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Is_Installed}" Value="True"><Setter Property="Text" Value="Installed" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Upgradeable}" Value="True"><Setter Property="Text" Value="Update" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#60758F" />
                                        <Setter TargetName="Card" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.012" ScaleY="1.012" /></Setter.Value></Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.88" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="#B81D2633" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0" Foreground="#B2B9CC" Text="{Binding LoadingText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="Transparent" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasResults}" Value="False" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="No games match these filters" />
                <TextBlock Margin="0,5,0,0" Foreground="#AEB8C7" Text="Try another search or clear a filter." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#AEB8C7" FontSize="12" Text="{Binding StatusText}" />
            <Button HorizontalAlignment="Right" Padding="14,7" Command="{Binding RefreshCommand}" Content="Refresh catalog"
                    ToolTip="Refetch games from T-Craft" />
        </Grid>
    </Grid>
</UserControl>
