<UserControl
    x:Class="TCLauncher.MVVM.View.ServerListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls"
    xmlns:converters="clr-namespace:TCLauncher.MVVM.Converters"
    xmlns:core="clr-namespace:TCLauncher.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#1D2633"
    d:DesignHeight="600"
    d:DesignWidth="960"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="CatalogView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock
                        FontFamily="{StaticResource PixelifySans}"
                        FontSize="29"
                        Text="{core:Localize Key=games_label_text}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="13"
                        Foreground="#AEB8C7"
                        Text="{core:Localize Key=discovery_subtitle}" />
                </StackPanel>
                <Button
                    x:Name="GamesMenuButton"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="GamesMenuButton_OnClick"
                    Content="☰"
                    ToolTip="Games menu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="CreateProfile_OnClick" Header="{core:Localize Key=create_profile}" />
                            <MenuItem Click="ImportPackage_OnClick" Header="{core:Localize Key=package_import}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    MinHeight="40"
                    AutomationProperties.Name="Search games"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Search by name, tag, version, or loader" />
                <ComboBox
                    Grid.Column="1"
                    Width="120"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Loader filter"
                    ItemsSource="{Binding LoaderFilters}"
                    SelectedItem="{Binding LoaderFilter}" />
                <ComboBox
                    Grid.Column="2"
                    Width="135"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Minecraft version filter"
                    ItemsSource="{Binding MinecraftVersionFilters}"
                    SelectedItem="{Binding MinecraftVersionFilter}" />
                <ComboBox
                    Grid.Column="3"
                    Width="120"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Availability filter"
                    ItemsSource="{Binding AvailabilityFilters}"
                    SelectedItem="{Binding AvailabilityFilter}" />
            </Grid>

            <ListBox
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                IsTabStop="False"
                ItemsSource="{Binding ServerList}"
                KeyboardNavigation.TabNavigation="Continue"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveCardPanel
                            Gap="16"
                            MaximumColumns="4"
                            MinimumCardWidth="230"
                            MinimumColumns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding DisplayName}"
                            Background="Transparent"
                            Click="GameCard_OnClick"
                            Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Card"
                                        MinHeight="232"
                                        Background="#273241"
                                        BorderBrush="#344255"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="12"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="140" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Background="#121923"
                                                ClipToBounds="True"
                                                CornerRadius="11,11,0,0">
                                                <Image Source="{Binding ThumbnailURL}" Stretch="UniformToFill">
                                                    <Image.OpacityMask>
                                                        <VisualBrush Stretch="Fill">
                                                            <VisualBrush.Visual>
                                                                <Border
                                                                    Width="100"
                                                                    Height="100"
                                                                    Background="Black"
                                                                    CornerRadius="11,11,0,0" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Image.OpacityMask>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                                <TextBlock
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Margin="0,9,0,0">
                                                    <Border
                                                        Margin="0,0,6,0"
                                                        Padding="7,3"
                                                        Background="#17202C"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#CED6E2"
                                                            Text="{Binding McVersion}" />
                                                    </Border>
                                                    <Border
                                                        Margin="0,0,6,0"
                                                        Padding="7,3"
                                                        Background="#17202C"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#CED6E2"
                                                            Text="{Binding Loader.Type}" />
                                                    </Border>
                                                    <Border
                                                        Padding="7,3"
                                                        Background="#183D35"
                                                        CornerRadius="6">
                                                        <TextBlock FontSize="11" Foreground="#83D5BB">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Available" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Is_Installed}" Value="True">
                                                                            <Setter Property="Text" Value="Installed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Upgradeable}" Value="True">
                                                                            <Setter Property="Text" Value="Update" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#60758F" />
                                            <Setter TargetName="Card" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.012" ScaleY="1.012" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Card" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border
                Grid.Row="2"
                Background="#B81D2633"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar
                        Width="180"
                        Height="4"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="#B2B9CC"
                        Text="{Binding LoadingText}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Background="Transparent"
                IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasResults}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{core:Localize Key=discovery_empty_title}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="#AEB8C7"
                        Text="{core:Localize Key=discovery_empty_help}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#AEB8C7"
                    Text="{Binding StatusText}" />
                <Button
                    Padding="14,7"
                    HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}"
                    Content="{core:Localize Key=refresh_catalog}"
                    ToolTip="Refetch games from T-Craft" />
            </Grid>
        </Grid>

        <Grid
            x:Name="DetailsView"
            Background="#1D2633"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button
                    MinWidth="86"
                    Click="BackFromDetails_OnClick"
                    Content="← Back"
                    DockPanel.Dock="Left" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Game details" />
            </DockPanel>
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="DetailsContent" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>