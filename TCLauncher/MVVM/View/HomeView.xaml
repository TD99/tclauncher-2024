<UserControl
    x:Class="TCLauncher.MVVM.View.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls"
    xmlns:core="clr-namespace:TCLauncher.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#1D2633"
    d:DesignHeight="600"
    d:DesignWidth="960"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource PixelifySans}" FontSize="29">
                            <Run Text="Welcome" /><Run x:Name="UserNameTextBlock" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="13"
                            Foreground="#AEB8C7"
                            Text="Pick a game and server below, then press Play." />
                    </StackPanel>
                    <TextBlock
                        x:Name="CatalogStatus"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="12"
                        Foreground="#EAB464" />
                </DockPanel>

                <TextBlock
                    Margin="0,8,0,10"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="{core:Localize Key=home_recent_profiles}" />
                <ItemsControl ItemsSource="{Binding RecentProfiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="180"
                                Margin="0,0,10,0"
                                Padding="13"
                                HorizontalContentAlignment="Left"
                                Click="RecentProfile_OnClick"
                                Tag="{Binding}">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#AEB8C7"
                                        Text="{Binding McVersion, StringFormat=Minecraft {0}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,22,0,10">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{core:Localize Key=home_for_you}" />
                    <Button
                        Padding="12,5"
                        Click="DiscoverButton_OnClick"
                        Content="{core:Localize Key=home_browse_games}"
                        DockPanel.Dock="Right" />
                </DockPanel>
                <ItemsControl x:Name="mainApplets">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveCardPanel
                                Gap="12"
                                MaximumColumns="3"
                                MinimumCardWidth="220"
                                MinimumColumns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                Click="AppletItem_OnClick"
                                Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Card"
                                            MinHeight="126"
                                            Padding="16"
                                            Background="#222D3B"
                                            BorderBrush="#344255"
                                            BorderThickness="1"
                                            CornerRadius="11">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#83D5BB"
                                                    Text="{Binding Origin}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Margin="0,7,0,0"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    MaxHeight="42"
                                                    Margin="0,7,0,0"
                                                    Foreground="#AEB8C7"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#60758F" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="18,12"
            Background="#253447"
            BorderBrush="#3B4C62"
            BorderThickness="1"
            CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="profileSelect"
                    Margin="0,0,14,0"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding LocalList}"
                    SelectedItem="{Binding LastSelected}"
                    SelectedValuePath="Guid"
                    SelectionChanged="ProfileSelect_SelectionChanged" />
                <Button
                    x:Name="playBtn"
                    Grid.Column="1"
                    Background="#2F7A65"
                    BorderBrush="#4AA88C"
                    Click="PlayBtn_Click"
                    Content="Play"
                    FontSize="17"
                    FontWeight="SemiBold" />
                <ComboBox
                    x:Name="ServerSelect"
                    Grid.Column="2"
                    Margin="14,0,0,0"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Address"
                    SelectionChanged="ServerSelect_OnSelectionChanged" />
            </Grid>
        </Border>
    </Grid>
</UserControl>