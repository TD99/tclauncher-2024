<UserControl
    x:Class="TCLauncher.MVVM.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core"
    xmlns:controls="clr-namespace:TCLauncher.MVVM.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#1D2633"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="#222D3B" />
            <Setter Property="BorderBrush" Value="#344255" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsSectionHeading" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="FontFamily" Value="{StaticResource PixelifySans}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Foreground" Value="#AEB8C7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#AEB8C7" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="NavItem"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="#26384D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="#315579" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock
                Margin="2,0,0,12"
                FontFamily="{StaticResource PixelifySans}"
                FontSize="29"
                Text="{core:Localize Key=settings_text}" />
            <Border
                Padding="10"
                Background="#18212D"
                BorderBrush="#2F4054"
                BorderThickness="1"
                CornerRadius="14">
                <ListBox
                    x:Name="SectionList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="SectionList_OnSelectionChanged">
                    <ListBoxItem Content="{core:Localize Key=settings_general}" Tag="General" />
                    <ListBoxItem Content="{core:Localize Key=settings_minecraft}" Tag="Minecraft" />
                    <ListBoxItem Content="{core:Localize Key=settings_storage}" Tag="Storage" />
                    <ListBoxItem Content="Services" Tag="Services" />
                    <ListBoxItem Content="Diagnostics" Tag="Diagnostics" />
                    <ListBoxItem Content="{core:Localize Key=settings_about}" Tag="About" />
                </ListBox>
            </Border>
        </StackPanel>
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="1"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <StackPanel x:Name="GeneralSection" Tag="General">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="{core:Localize Key=settings_general}" />
                    <Border
                        x:Name="StartupCard"
                        Style="{StaticResource SettingCard}"
                        Tag="startup behavior minimize close">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_after_launch}" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_after_launch_help}" />
                            <ComboBox x:Name="Behaviour" SelectionChanged="Behaviour_SelectionChanged">
                                <ComboBoxItem Content="{core:Localize Key=keep_open_text}" Tag="0" />
                                <ComboBoxItem Content="{core:Localize Key=minimize_text}" Tag="1" />
                                <ComboBoxItem Content="{core:Localize Key=close_text}" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="LanguageCard"
                        Style="{StaticResource SettingCard}"
                        Tag="language english german french restart">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=language}" />
                                <Border
                                    Padding="7,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderBrush="#6B5730"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    DockPanel.Dock="Right">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#EAB464"
                                        Text="{core:Localize Key=restart_badge}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_language_help}" />
                            <ComboBox x:Name="LanguageSelector" SelectionChanged="LanguageSelector_OnSelectionChanged">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Deutsch" Tag="de" />
                                <ComboBoxItem Content="Français" Tag="fr" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="AppearanceCard"
                        Style="{StaticResource SettingCard}"
                        Tag="appearance font pixel readability restart">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_typography}" />
                                <Border
                                    Padding="7,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderBrush="#6B5730"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    DockPanel.Dock="Right">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#EAB464"
                                        Text="{core:Localize Key=restart_badge}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_typography_help}" />
                            <CheckBox
                                x:Name="CheckBoxUsePixelFontEverywhere"
                                Checked="PixelFont_OnChanged"
                                Content="{core:Localize Key=settings_pixel_global}"
                                Unchecked="PixelFont_OnChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="MinecraftSection"
                    Tag="Minecraft"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="{core:Localize Key=settings_minecraft}" />
                    <Border
                        x:Name="JavaCard"
                        Style="{StaticResource SettingCard}"
                        Tag="java runtime health memory">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Java runtime" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_java_help}" />
                            <TextBox
                                x:Name="JavaStatus"
                                Padding="3"
                                Foreground="#83D5BB"
                                IsReadOnly="True"
                                FontFamily="{StaticResource FiraCode}"
                                IsReadOnlyCaretVisible="False"
                                TextAlignment="Left"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Expander Margin="0,4,0,0" Header="{core:Localize Key=settings_advanced}">
                        <StackPanel Margin="0,12,0,0">
                            <Border
                                x:Name="MultiCard"
                                Style="{StaticResource SettingCard}"
                                Tag="multiple instances process">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=multi_instances_text}" />
                                    <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_multi_help}" />
                                    <ComboBox x:Name="MultiInstances" SelectionChanged="MultiInstances_OnSelectionChanged">
                                        <ComboBoxItem Content="{core:Localize Key=auto_detect_text}" Tag="0" />
                                        <ComboBoxItem Content="{core:Localize Key=forbid_text}" Tag="1" />
                                        <ComboBoxItem Content="{core:Localize Key=allow_text}" Tag="2" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="SandboxCard"
                                Style="{StaticResource SettingCard}"
                                Tag="sandbox isolation shared strict">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_sandboxing}" />
                                    <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_sandboxing_help}" />
                                    <ComboBox x:Name="SandboxLevel" SelectionChanged="SandboxLevel_OnSelectionChanged">
                                        <ComboBoxItem Content="{core:Localize Key=standard_text}" Tag="0" />
                                        <ComboBoxItem Content="{core:Localize Key=strict_text}" Tag="1" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel
                    x:Name="StorageSection"
                    Tag="Storage"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="{core:Localize Key=settings_storage}" />
                    <Border
                        x:Name="PathCard"
                        Style="{StaticResource SettingCard}"
                        Tag="storage path appdata migration move restart">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_data_location}" />
                                <Border
                                    Padding="7,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderBrush="#6B5730"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    DockPanel.Dock="Right">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#EAB464"
                                        Text="{core:Localize Key=restart_badge}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_data_location_help}" />
                            <TextBox x:Name="AppDataPath" TextChanged="DebouncedTextSetting_OnChanged" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button
                                    Padding="14,8"
                                    Click="BrowseDataLocation_OnClick"
                                    Content="Choose folder" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Click="MigrateStorage_OnClick"
                                    Content="{core:Localize Key=settings_move_data}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Expander Margin="0,4,0,0" Header="{core:Localize Key=settings_destructive}">
                        <Border
                            x:Name="ResetCard"
                            Margin="0,12,0,0"
                            Style="{StaticResource SettingCard}"
                            Tag="reset settings data destructive">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_reset_setup}" />
                                <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_reset_setup_help}" />
                                <WrapPanel>
                                    <Button
                                        Padding="12,7"
                                        Click="resetSettBtn_Click"
                                        Content="{core:Localize Key=reset_local_settings_text}" />
                                    <Button
                                        Margin="8,0,0,0"
                                        Padding="12,7"
                                        Click="resetDataBtn_Click"
                                        Content="{core:Localize Key=settings_reset_all_data}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>

                <StackPanel
                    x:Name="ServicesSection"
                    Tag="Services"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="Services" />
                    <Border
                        x:Name="MirrorCard"
                        Style="{StaticResource SettingCard}"
                        Tag="download mirror endpoint network">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Service endpoint" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_download_service_help}" />
                            <TextBox x:Name="DownloadMirror" TextChanged="DebouncedTextSetting_OnChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="DiagnosticsSection"
                    Tag="Diagnostics"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="Diagnostics" />
                    <Border
                        x:Name="DiagnosticsCard"
                        Style="{StaticResource SettingCard}"
                        Tag="privacy diagnostics support logs bundle telemetry">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{core:Localize Key=settings_local_diagnostics}" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_local_diagnostics_help}" />
                            <WrapPanel>
                                <Button
                                    Padding="14,8"
                                    Click="SupportBundle_Click"
                                    Content="{core:Localize Key=support_bundle}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Click="OpenLogs_OnClick"
                                    Content="{core:Localize Key=open_logs}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="AboutSection"
                    Tag="About"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeading}" Text="{core:Localize Key=settings_about}" />
                    <Border
                        x:Name="AboutCard"
                        Padding="0"
                        Style="{StaticResource SettingCard}"
                        Tag="about version framework windows edition copyright">
                        <Grid>
                            <StackPanel Margin="16,16,196,16">
                                <TextBlock
                                    FontFamily="{StaticResource PixelifySans}"
                                    FontSize="24"
                                    Text="TCLauncher Windows Edition" />
                                <TextBlock x:Name="assemblyVersion" Margin="0,12,0,0" />
                                <TextBlock x:Name="frameworkVersion" Margin="0,7,0,0" />
                                <TextBlock x:Name="CopyrightCompilationYear" Margin="0,7,0,0" />
                                <Button
                                    Margin="0,16,0,0"
                                    Padding="14,8"
                                    HorizontalAlignment="Left"
                                    Click="ReSetupBtn_OnClick"
                                    Content="{core:Localize Key=settings_run_setup}" />
                            </StackPanel>
                            <Canvas
                                x:Name="AboutMascotHost"
                                ClipToBounds="True"
                                IsHitTestVisible="False"
                                SizeChanged="AboutMascotHost_OnSizeChanged">
                                <Image
                                    x:Name="AboutMascot"
                                    Canvas.Bottom="0"
                                    Canvas.Right="30"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="/Assets/Images/tclauncher-mascot-seated-looking-right.png"
                                    Stretch="Uniform"
                                    UseLayoutRounding="True" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="UpdateCard"
                        Style="{StaticResource SettingCard}"
                        Tag="updates installer version">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Launcher updates" />
                            <TextBlock Style="{StaticResource SettingHelp}" Text="{core:Localize Key=settings_updates_help}" />
                            <controls:LoadingButton
                                x:Name="updateBtn"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Click="updateBtn_Click"
                                Content="{core:Localize Key=search_for_updates_text}"
                                Style="{StaticResource LoadingButton}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
