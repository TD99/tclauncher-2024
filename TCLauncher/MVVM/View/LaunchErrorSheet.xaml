<UserControl x:Class="TCLauncher.MVVM.View.LaunchErrorSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel><Border Padding="14" Background="#3B2830" CornerRadius="9"><TextBlock Text="{Binding}" Foreground="#FFD1D1" TextWrapping="Wrap"/></Border><TextBlock Margin="0,13,0,0" Foreground="#AEB8C7" Text="Retry the launch, inspect the profile in Games, or open the launcher logs." TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0" HorizontalAlignment="Right"><Button Padding="14,8" Content="Open logs" Click="Logs_Click"/><Button Margin="8,0,0,0" Padding="14,8" Content="Repair" Click="Repair_Click"/><Button Margin="8,0,0,0" Padding="14,8" Content="Retry" Click="Retry_Click"/></WrapPanel></StackPanel>
</UserControl>
