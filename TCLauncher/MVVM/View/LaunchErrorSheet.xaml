<UserControl
    x:Class="TCLauncher.MVVM.View.LaunchErrorSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core">
    <StackPanel>
        <Border
            Padding="14"
            Background="#3B2830"
            CornerRadius="9">
            <TextBlock
                Foreground="#FFD1D1"
                Text="{Binding}"
                TextWrapping="Wrap" />
        </Border>
        <TextBlock
            Margin="0,13,0,0"
            Foreground="#AEB8C7"
            Text="{core:Localize Key=launch_error_help}"
            TextWrapping="Wrap" />
        <WrapPanel Margin="0,18,0,0" HorizontalAlignment="Right">
            <Button
                Padding="14,8"
                Click="Logs_Click"
                Content="{core:Localize Key=open_logs}" />
            <Button
                Margin="8,0,0,0"
                Padding="14,8"
                Click="Repair_Click"
                Content="{core:Localize Key=repair_action}" />
            <Button
                Margin="8,0,0,0"
                Padding="14,8"
                Click="Retry_Click"
                Content="{core:Localize Key=retry_action}" />
        </WrapPanel>
    </StackPanel>
</UserControl>