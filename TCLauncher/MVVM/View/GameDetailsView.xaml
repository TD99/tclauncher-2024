<UserControl
    x:Class="TCLauncher.MVVM.View.GameDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core"
    Focusable="False"
    IsTabStop="False">
    <StackPanel MaxWidth="920" Margin="0,0,18,18">
        <Border
            Height="220"
            Background="#121923"
            ClipToBounds="True"
            CornerRadius="12">
            <Image Source="{Binding Game.ThumbnailURL}" Stretch="UniformToFill" />
        </Border>
        <TextBlock
            Margin="0,18,0,0"
            FontSize="26"
            FontWeight="SemiBold"
            Text="{Binding Game.DisplayName}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,7,0,0"
            Foreground="#AEB8C7"
            Text="{Binding Summary}"
            TextWrapping="Wrap" />
        <WrapPanel Margin="0,14,0,0">
            <Border
                Margin="0,0,7,0"
                Padding="8,4"
                Background="#17202C"
                CornerRadius="6">
                <TextBlock Text="{Binding Game.McVersion}" />
            </Border>
            <Border
                Margin="0,0,7,0"
                Padding="8,4"
                Background="#17202C"
                CornerRadius="6">
                <TextBlock Text="{Binding LoaderLabel}" />
            </Border>
            <Border
                Padding="8,4"
                Background="#183D35"
                CornerRadius="6">
                <TextBlock Foreground="#83D5BB" Text="{Binding StateLabel}" />
            </Border>
        </WrapPanel>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Padding="18,10"
                Click="MainAction_OnClick"
                Content="{Binding MainActionLabel}" />
            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="14,10"
                Click="Play_OnClick"
                Content="Play"
                Visibility="{Binding InstalledVisibility}" />
            <Button
                x:Name="ManageButton"
                Grid.Column="2"
                Width="42"
                Margin="8,0,0,0"
                Click="Manage_OnClick"
                Content="•••"
                Visibility="{Binding InstalledVisibility}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="Configure_OnClick" Header="{core:Localize Key=configure_action}" />
                        <MenuItem Click="Clone_OnClick" Header="{core:Localize Key=clone_action}" />
                        <MenuItem Click="Export_OnClick" Header="{core:Localize Key=export_package}" />
                        <Separator />
                        <MenuItem Click="OpenFolder_OnClick" Header="{core:Localize Key=open_folder}" />
                        <MenuItem Click="ManageBackups_OnClick" Header="{core:Localize Key=manage_backups}" />
                        <MenuItem Click="Health_OnClick" Header="Health &amp; support" />
                        <MenuItem Click="Repair_OnClick" Header="Repair" />
                        <Separator />
                        <MenuItem
                            Click="Uninstall_OnClick"
                            Foreground="#FF9A9A"
                            Header="{core:Localize Key=uninstall_action}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Border
            Margin="0,22,0,0"
            Padding="16"
            Background="#202B39"
            CornerRadius="10">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{core:Localize Key=overview}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#C4CCD8"
                    Text="{Binding Overview}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            Margin="0,12,0,0"
            Padding="16"
            Background="#202B39"
            CornerRadius="10">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{core:Localize Key=health_backups}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#C4CCD8"
                    Text="{Binding HealthSummary}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>