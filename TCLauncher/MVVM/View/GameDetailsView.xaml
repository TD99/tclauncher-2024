<UserControl x:Class="TCLauncher.MVVM.View.GameDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" IsTabStop="False">
    <StackPanel>
        <Border Height="220" Background="#121923" CornerRadius="12" ClipToBounds="True">
            <Image Source="{Binding Game.ThumbnailURL}" Stretch="UniformToFill" />
        </Border>
        <TextBlock Margin="0,18,0,0" FontSize="26" FontWeight="SemiBold" Text="{Binding Game.DisplayName}" TextWrapping="Wrap" />
        <TextBlock Margin="0,7,0,0" Foreground="#AEB8C7" Text="{Binding Summary}" TextWrapping="Wrap" />
        <WrapPanel Margin="0,14,0,0">
            <Border Margin="0,0,7,0" Padding="8,4" Background="#17202C" CornerRadius="6"><TextBlock Text="{Binding Game.McVersion}" /></Border>
            <Border Margin="0,0,7,0" Padding="8,4" Background="#17202C" CornerRadius="6"><TextBlock Text="{Binding LoaderLabel}" /></Border>
            <Border Padding="8,4" Background="#183D35" CornerRadius="6"><TextBlock Foreground="#83D5BB" Text="{Binding StateLabel}" /></Border>
        </WrapPanel>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Padding="18,10" Content="{Binding MainActionLabel}" Click="MainAction_OnClick" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,10" Content="Play" Click="Play_OnClick"
                    Visibility="{Binding InstalledVisibility}" />
            <Button x:Name="ManageButton" Grid.Column="2" Margin="8,0,0,0" Width="42" Content="•••" Click="Manage_OnClick"
                    Visibility="{Binding InstalledVisibility}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Configure" Click="Configure_OnClick" />
                        <MenuItem Header="Clone" Click="Clone_OnClick" />
                        <MenuItem Header="Export package" Click="Export_OnClick" />
                        <Separator />
                        <MenuItem Header="Open folder" Click="OpenFolder_OnClick" />
                        <MenuItem Header="Manage backups" Click="ManageBackups_OnClick" />
                        <MenuItem Header="Health &amp; support" Click="Health_OnClick" />
                        <MenuItem Header="Repair" Click="Repair_OnClick" />
                        <Separator />
                        <MenuItem Header="Uninstall" Foreground="#FF9A9A" Click="Uninstall_OnClick" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Border Margin="0,22,0,0" Padding="16" Background="#202B39" CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Overview" />
                <TextBlock Margin="0,8,0,0" Foreground="#C4CCD8" Text="{Binding Overview}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Margin="0,12,0,0" Padding="16" Background="#202B39" CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Health &amp; backups" />
                <TextBlock Margin="0,8,0,0" Foreground="#C4CCD8" Text="{Binding HealthSummary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
