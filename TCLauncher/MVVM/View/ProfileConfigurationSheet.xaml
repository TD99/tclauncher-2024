<UserControl x:Class="TCLauncher.MVVM.View.ProfileConfigurationSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Margin="0,0,0,6" Text="Display name"/><TextBox x:Name="DisplayName"/>
        <UniformGrid Margin="0,14,0,0" Columns="2"><StackPanel Margin="0,0,7,0"><TextBlock Margin="0,0,0,6" Text="Minimum RAM (MB)"/><TextBox x:Name="MinimumRam"/></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Margin="0,0,0,6" Text="Maximum RAM (MB)"/><TextBox x:Name="MaximumRam"/></StackPanel></UniformGrid>
        <TextBlock Margin="0,14,0,6" Text="JVM arguments (one per line)"/><TextBox x:Name="JvmArguments" MinHeight="100" Style="{StaticResource ModernMultilineTextBox}"/>
        <CheckBox x:Name="Isolated" Margin="0,14,0,0" Content="Keep this profile isolated"/>
        <TextBlock x:Name="Error" Margin="0,12,0,0" Foreground="#FF9A9A" TextWrapping="Wrap"/>
        <Button Margin="0,18,0,0" HorizontalAlignment="Right" Padding="18,9" Content="Save changes" Click="Save_Click"/>
    </StackPanel>
</UserControl>
