<UserControl
    x:Class="TCLauncher.MVVM.View.PackageExportSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:TCLauncher.Core">
    <StackPanel>
        <TextBlock
            x:Name="ProfileDetails"
            Foreground="#B2B9CC"
            TextWrapping="Wrap" />
        <Border
            Margin="0,18,0,0"
            Padding="16"
            Background="#202B39"
            CornerRadius="10">
            <StackPanel>
                <CheckBox x:Name="IncludeSaves" Content="{core:Localize Key=include_saves}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#8EA6C8"
                    Text="Tokens, logs, caches, and unrelated personal data are never included."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,18,0,6" Text="Destination" />
        <DockPanel>
            <Button
                Margin="8,0,0,0"
                Click="Browse_Click"
                Content="Choose…"
                DockPanel.Dock="Right" />
            <TextBox x:Name="Destination" IsReadOnly="True" />
        </DockPanel>
        <TextBlock
            x:Name="Status"
            Margin="0,12,0,0"
            Foreground="#FF9A9A"
            TextWrapping="Wrap" />
        <Button
            Margin="0,18,0,0"
            Padding="18,9"
            HorizontalAlignment="Right"
            Click="Export_Click"
            Content="{core:Localize Key=export_package}" />
    </StackPanel>
</UserControl>