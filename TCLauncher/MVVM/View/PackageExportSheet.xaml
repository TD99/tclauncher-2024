<UserControl x:Class="TCLauncher.MVVM.View.PackageExportSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="ProfileDetails" Foreground="#B2B9CC" TextWrapping="Wrap"/>
        <Border Margin="0,18,0,0" Padding="16" Background="#202B39" CornerRadius="10">
            <StackPanel><CheckBox x:Name="IncludeSaves" Content="Include saves"/><TextBlock Margin="0,8,0,0" Foreground="#8EA6C8" TextWrapping="Wrap" Text="Tokens, logs, caches, and unrelated personal data are never included."/></StackPanel>
        </Border>
        <TextBlock Margin="0,18,0,6" Text="Destination"/><DockPanel><Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Choose…" Click="Browse_Click"/><TextBox x:Name="Destination" IsReadOnly="True"/></DockPanel>
        <TextBlock x:Name="Status" Margin="0,12,0,0" Foreground="#FF9A9A" TextWrapping="Wrap"/>
        <Button Margin="0,18,0,0" HorizontalAlignment="Right" Padding="18,9" Content="Export package" Click="Export_Click"/>
    </StackPanel>
</UserControl>
